{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QVerisAI/open-qveris-skills/qveris-news-sentiment-radar/schemas/output.schema.json",
  "title": "News Sentiment Radar Business Output",
  "type": "object",
  "required": ["schema_version", "skill_id", "generated_at", "mode", "scope", "findings", "evidence", "risks", "usage", "result"],
  "properties": {
    "schema_version": { "type": "string" },
    "skill_id": { "type": "string", "enum": ["qveris-news-sentiment-radar"] },
    "generated_at": { "type": "string" },
    "mode": { "type": "string", "enum": ["dry-run", "fixture", "live"] },
    "scope": {
      "type": "object",
      "required": ["ticker", "market", "window_days", "from", "to"],
      "properties": {
        "ticker": { "type": "string" },
        "market": { "type": "string" },
        "window_days": { "type": "number" },
        "from": { "type": "string" },
        "to": { "type": "string" }
      }
    },
    "findings": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "usage": {
      "type": "object",
      "required": ["paid_calls", "estimated_credits"],
      "properties": {
        "paid_calls": { "type": "number" },
        "estimated_credits": { "type": "number" }
      }
    },
    "result": {
      "type": "object",
      "required": ["ticker", "sentiment_counts", "total_records", "signal_level", "catalyst_status", "evidence_roles", "missing_data"],
      "properties": {
        "ticker": { "type": "string" },
        "sentiment_counts": {
          "type": "object",
          "required": ["positive", "negative", "neutral"],
          "properties": {
            "positive": { "type": "number" },
            "negative": { "type": "number" },
            "neutral": { "type": "number" }
          }
        },
        "total_records": { "type": "number" },
        "signal_level": { "type": "string", "enum": ["positive", "negative", "mixed", "insufficient_data"] },
        "catalyst_status": { "type": "string" },
        "catalyst_confidence_score": { "type": "number" },
        "corroborating_roles": { "type": "array", "items": { "type": "string" } },
        "evidence_roles": { "type": "array", "items": { "type": "string" } },
        "missing_data": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
