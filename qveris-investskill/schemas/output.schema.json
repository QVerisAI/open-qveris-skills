{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QVeris Finance Skill Output",
  "type": "object",
  "required": [
    "skill",
    "source_record",
    "controls",
    "analysis",
    "data_quality",
    "qveris_trace",
    "disclaimer"
  ],
  "properties": {
    "skill": {
      "type": "string"
    },
    "source_record": {
      "type": "object"
    },
    "controls": {
      "type": "object",
      "required": [
        "dry_run",
        "max_calls",
        "max_age",
        "budget_note"
      ],
      "properties": {
        "dry_run": {
          "type": "boolean"
        },
        "max_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_age": {
          "type": "string"
        },
        "budget_note": {
          "type": "string"
        }
      }
    },
    "analysis": {
      "type": "object"
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qveris_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool_name",
          "capability_id",
          "entity",
          "market",
          "params",
          "as_of",
          "retrieved_at",
          "fallback_used",
          "missing_fields"
        ],
        "properties": {
          "tool_name": {
            "type": "string",
            "pattern": "^qveris_finance\\."
          },
          "capability_id": {
            "type": "string"
          },
          "entity": {
            "type": "string"
          },
          "market": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "as_of": {
            "type": "string"
          },
          "retrieved_at": {
            "type": "string"
          },
          "fallback_used": {
            "type": "boolean"
          },
          "missing_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_provider": {
            "type": "string",
            "description": "QVeris internal provenance only; not a direct skill dependency."
          },
          "quality_note": {
            "type": "string"
          }
        }
      }
    },
    "disclaimer": {
      "type": "string",
      "const": "不构成投资建议 / Not investment advice."
    },
    "data_quality": {
      "type": "object",
      "required": [
        "status",
        "warnings",
        "stale_fields",
        "out_of_window_events",
        "suppressed_fields"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "limited",
            "insufficient"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stale_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_window_events": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "suppressed_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "suppressed_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
