{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qveris.ai/schemas/serenity-research-output-v1.json",
  "title": "QVeris Serenity supply-chain research output",
  "type": "object",
  "required": [
    "schema_version", "status", "workflow_stage", "controls", "as_of", "cutoff", "scope", "planned_universe", "evidence_matrix", "planned_calls", "required_factors", "evidence", "layers",
    "candidates", "validity", "data_quality", "observed_call_count", "qveris_trace",
    "web_trace", "disclaimer"
  ],
  "properties": {
    "schema_version": {"const": "qveris.serenity-research-output.v1"},
    "status": {"enum": ["accepted", "degraded", "rejected", "initial_pass", "budget_limited", "blocked"]},
    "workflow_stage": {"enum": ["planned", "evidence_acquired", "validated", "complete"]},
    "controls": {
      "type": "object",
      "required": ["workflow", "dry_run", "max_calls", "max_web_operations", "max_age", "budget_note", "source_mode"],
      "properties": {
        "workflow": {"enum": ["theme_scan", "company_challenge", "candidate_compare", "research_dialogue", "scorecard_review"]},
        "dry_run": {"type": "boolean"},
        "max_calls": {"type": "integer", "minimum": 0},
        "max_web_operations": {"type": "integer", "minimum": 0},
        "max_age": {"type": "string"},
        "budget_note": {"type": "string"},
        "source_mode": {"type": "string"}
      },
      "additionalProperties": false
    },
    "as_of": {"type": "string", "format": "date-time"},
    "cutoff": {
      "type": "object",
      "required": ["T0", "CUT_OFF", "effective_cutoff"],
      "properties": {
        "T0": {"type": "string", "format": "date-time"},
        "CUT_OFF": {"type": "string", "format": "date-time"},
        "effective_cutoff": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "scope": {"type": "object"},
    "planned_universe": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lead", "status"],
        "properties": {
          "lead": {"type": "string", "minLength": 1},
          "status": {"enum": ["discovered_lead", "user_supplied_unverified", "planned_identity_check"]}
        },
        "additionalProperties": true
      }
    },
    "evidence_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "required"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "status": {"enum": ["observed", "calculated", "estimated", "not_applicable", "missing"]}
        },
        "additionalProperties": true
      }
    },
    "planned_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool_name", "purpose", "required", "call_estimate", "batch_assumption"],
        "properties": {
          "tool_name": {"type": "string", "pattern": "^qveris_finance\\.[a-z0-9_]+$"},
          "purpose": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "call_estimate": {"type": "integer", "minimum": 0},
          "batch_assumption": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "required_factors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "layers": {"type": "array", "items": {"$ref": "#/$defs/layer"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "validity": {"$ref": "#/$defs/validity"},
    "data_quality": {"$ref": "#/$defs/data_quality"},
    "observed_call_count": {"type": "integer", "minimum": 0},
    "qveris_trace": {"type": "array", "items": {"$ref": "#/$defs/trace"}},
    "web_trace": {"type": "array"},
    "disclaimer": {"const": "Not investment advice."}
  },
  "additionalProperties": false,
  "$defs": {
    "coverage": {"enum": ["complete_comparable", "partial_not_ranked", "proxy_only", "insufficient"]},
    "factor": {
      "type": "object",
      "required": ["rating", "evidence_ids"],
      "properties": {
        "rating": {"type": "number", "minimum": 0, "maximum": 5},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "status", "source_type", "entity_or_topic", "evidence_owner"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "status": {"const": "accepted"},
        "source_type": {"enum": ["qveris_finance", "web"]},
        "entity_or_topic": {"type": "string", "minLength": 1},
        "evidence_owner": {"type": "string", "minLength": 1},
        "as_of": {"type": "string"},
        "published_at": {"type": "string"},
        "accessed_at": {"type": "string"},
        "query": {"type": "string"},
        "observed_at": {"type": "string"},
        "tool_name": {"type": "string", "pattern": "^qveris_finance\\.[a-z0-9_]+$"},
        "symbol": {"type": "string"},
        "execution_id": {"type": ["string", "null"]},
        "final_url": {"type": "string"},
        "title": {"type": "string"},
        "publisher_owner": {"type": "string"},
        "independence_result": {"type": "string"},
        "body_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "issuer_or_topic_match": {"type": "boolean"},
        "window_match": {"type": "boolean"},
        "window_start": {"type": "string"},
        "window_end": {"type": "string"},
        "fiscal_period": {"type": "string"},
        "measurement_basis": {"type": "string"},
        "currency_convention": {"type": "string"}
      },
      "additionalProperties": true
    },
    "layer": {
      "type": "object",
      "required": ["layer_id", "constrained_function", "scarcity_mechanisms", "evidence_ids", "criteria"],
      "properties": {
        "layer_id": {"type": "string", "minLength": 1},
        "constrained_function": {"type": "string", "minLength": 1},
        "scarcity_mechanisms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "criteria": {
          "type": "object",
          "required": ["constrained_function_criticality", "scarcity_mechanism_strength", "substitution_difficulty", "evidence_quality"],
          "properties": {
            "constrained_function_criticality": {"$ref": "#/$defs/factor"},
            "scarcity_mechanism_strength": {"$ref": "#/$defs/factor"},
            "substitution_difficulty": {"$ref": "#/$defs/factor"},
            "evidence_quality": {"$ref": "#/$defs/factor"}
          },
          "additionalProperties": false
        },
        "rank": {"type": "integer", "minimum": 1},
        "priority_score": {"type": "number", "minimum": 0, "maximum": 100}
      },
      "additionalProperties": true
    },
    "candidate": {
      "type": "object",
      "required": ["symbol", "market", "coverage_tier", "window_start", "window_end", "fiscal_period", "measurement_basis", "currency_convention", "identity_evidence_ids", "factors", "counterevidence_ids", "denominator_checks"],
      "properties": {
        "symbol": {"type": "string", "minLength": 1},
        "market": {"type": "string", "minLength": 1},
        "coverage_tier": {"$ref": "#/$defs/coverage"},
        "window_start": {"type": "string"},
        "window_end": {"type": "string"},
        "fiscal_period": {"type": "string", "minLength": 1},
        "measurement_basis": {"type": "string", "minLength": 1},
        "currency_convention": {"type": "string", "minLength": 1},
        "identity_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "factors": {"type": "object", "additionalProperties": {"$ref": "#/$defs/factor"}},
        "counterevidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "denominator_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["metric", "value", "evidence_ids"],
            "properties": {
              "metric": {"type": "string", "minLength": 1},
              "value": {"type": "number", "exclusiveMinimum": 0},
              "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "validity": {
      "type": "object",
      "required": ["schema_version", "status", "layer_ranking_allowed", "layer_ranking", "candidate_ranking_allowed", "comparable_candidate_count", "violations"],
      "properties": {
        "schema_version": {"const": "qveris.serenity-research-validity.v1"},
        "status": {"enum": ["accepted", "degraded", "rejected"]},
        "layer_ranking_allowed": {"type": "boolean"},
        "layer_ranking": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rank", "layer_id", "priority_score"],
            "properties": {
              "rank": {"type": "integer", "minimum": 1},
              "layer_id": {"type": "string", "minLength": 1},
              "priority_score": {"type": "number", "minimum": 0, "maximum": 100}
            },
            "additionalProperties": false
          }
        },
        "candidate_ranking_allowed": {"type": "boolean"},
        "comparable_candidate_count": {"type": "integer", "minimum": 0},
        "violations": {"type": "array"}
      },
      "additionalProperties": true
    },
    "data_quality": {
      "type": "object",
      "required": ["status", "missing_fields"],
      "properties": {
        "status": {"enum": ["complete", "partial", "rejected", "initial_pass", "budget_limited", "blocked"]},
        "missing_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "blocking_reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "trace": {
      "type": "object",
      "required": ["tool_name", "params", "status", "execution_id", "fallback_used", "missing_fields"],
      "properties": {
        "tool_name": {"type": "string", "pattern": "^qveris_finance\\.[a-z0-9_]+$"},
        "params": {"type": "object"},
        "status": {"enum": ["success", "failed", "rejected"]},
        "execution_id": {"type": ["string", "null"]},
        "fallback_used": {"type": "boolean"},
        "missing_fields": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
