{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-bound Serenity scorecard input",
  "type": "object",
  "required": ["symbol", "validation_input", "penalties", "what_could_weaken_view"],
  "properties": {
    "symbol": {"type": "string", "minLength": 1},
    "validation_input": {"type": "object"},
    "penalties": {
      "type": "object",
      "minProperties": 8,
      "maxProperties": 8,
      "additionalProperties": {
        "type": "object",
        "required": ["rating", "evidence_ids"],
        "properties": {
          "rating": {"type": "number", "minimum": 0, "maximum": 5},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "what_could_weaken_view": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
